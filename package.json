{
  "name": "slack-linear-triage-agent",
  "version": "1.0.0",
  "description": "Customizable Slack-to-Linear triage agent using the Claude Agent SDK. Monitors a Slack channel, creates Linear tickets from actionable messages, and handles follow-ups.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@linear/sdk": "^95.2.0",
    "@slack/bolt": "^5.1.0",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
